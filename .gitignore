# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
out/
*.tsbuildinfo

# rust / tauri
apps/shell/src-tauri/target/
# Tauri 生成的移动端工程：可用 `tauri android init` / `tauri ios init` 重建
apps/shell/src-tauri/gen/
# 仓库内的 Gradle 影子目录（复用 ~/.gradle 的 wrapper 与 caches，但不继承失效的代理配置）
.gradle-home/
# 构建出来供安装的 APK（可随时重建）
.apk-out/
# 签名密钥：绝不入库（见 .keystore/README.md）
.keystore/

# fixtures generated on demand
fixtures/chats/large.jsonl

# test / coverage
coverage/

# local runtime data (never commit user data, keys or synced stores)
.data/
*.local.json
*.local.yaml
# 本地文件夹同步的临时测试目录（把设备上的 sync 拉下来时用）
.tmp-folder-sync/
.tmp-folder-sync.tar
# WebDAV 假 NAS 的落盘目录
.webdav-out/

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# local commit message scratch files
.commit-msg*.tmp