{
  "name": "storylantern",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Story Lantern — 本地优先的 AI 角色扮演与创作工作台（一切皆插件）",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"packages/**/*.test.ts\" \"plugins/**/*.test.ts\" \"apps/**/*.test.ts\" \"fixtures/**/*.test.ts\" \"eval/**/*.test.ts\"",
    "test:watch": "node --test --watch \"packages/**/*.test.ts\" \"plugins/**/*.test.ts\" \"apps/**/*.test.ts\" \"fixtures/**/*.test.ts\" \"eval/**/*.test.ts\"",
    "fixtures": "node fixtures/tools/make-fixtures.mjs",
    "gate": "node scripts/check-boundaries.mjs",
    "bundle": "node apps/shell/build-frontend.mjs && node scripts/check-bundle.mjs",
    "perf": "node eval/perf/budgets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run gate && npm run bundle && npm test",
    "reproducible": "node scripts/check-reproducible-build.mjs",
    "release:check": "npm run gate && npm run typecheck && npm run bundle && npm test && npm run reproducible && cargo check --manifest-path apps/shell/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
