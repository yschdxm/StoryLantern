{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Story Lantern",
  "version": "0.0.1",
  "identifier": "app.storylantern",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://127.0.0.1:5199",
    "beforeDevCommand": "node build-frontend.mjs --watch",
    "beforeBuildCommand": "node build-frontend.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Story Lantern",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
