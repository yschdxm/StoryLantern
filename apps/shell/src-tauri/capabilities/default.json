{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Story Lantern 的默认能力集：允许界面使用事件通道（流式 IPC 需要 listen/unlisten）。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit"
  ]
}
